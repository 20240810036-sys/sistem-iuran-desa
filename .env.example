APP_NAME="Sistem Iuran Sampah Desa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.example.com
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Sesi aman: cookie HttpOnly (default), Secure (HTTPS only), terenkripsi
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false

# Password akun demo saat menjalankan db:seed (jangan commit nilainya)
SEED_ADMIN_PASSWORD=
SEED_WARGA_PASSWORD=
